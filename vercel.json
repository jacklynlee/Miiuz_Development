{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.mjs": {
      "maxDuration": 120,
      "includeFiles": "js/**"
    },
    "api/translate.mjs": {
      "maxDuration": 120,
      "includeFiles": "js/**"
    },
    "api/places.mjs": {
      "maxDuration": 30,
      "includeFiles": "js/**"
    },
    "api/media.mjs": {
      "maxDuration": 60,
      "includeFiles": "js/**"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
