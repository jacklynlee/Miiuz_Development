# Copy to .env for local development (npm run dev:env). On Vercel, set these in Project Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional: switch model (default claude-opus-5-5)
# MIIUZ_MODEL=claude-opus-5-5
# Optional: only accept chat requests from these origins (comma-separated)
# MIIUZ_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: chat requests per IP per 10 minutes (default 40)
# MIIUZ_RATE_LIMIT=40

# Membership (Supabase → Project Settings → API). Both are public by design.
# Never put the service_role / secret key here.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: place search. Defaults to OpenStreetMap's free Nominatim (about 1 request/second).
# For heavier use, a Nominatim-compatible service such as LocationIQ:
# MIIUZ_GEOCODER_URL=https://us1.locationiq.com/v1
# MIIUZ_GEOCODER_KEY=
# Optional: place searches per IP per 10 minutes (default 80)
# MIIUZ_PLACES_LIMIT=80

# Optional: force older copies of the app to update (only for breaking API changes or wrong
# safety facts, never for normal releases). Leave unset normally. See README → Updates.
# MIIUZ_MIN_VERSION=1.0.1
